{
  "name": "@stacks/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @stacks/api dev",
    "dev:api": "vp run --filter @stacks/api dev",
    "dev:mobile": "vp run --filter @stacks/mobile dev",
    "build": "vp run --filter @stacks/api build && vp run --filter @stacks/mobile build",
    "typecheck": "vp run -r --cache typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run scripts && vp run -r test",
    "verify:ios-live-activity": "npm exec --yes --package=eas-cli@27.11.0 --package=agent-device@0.21.41 -- node scripts/verify-ios-live-activity.mjs",
    "verify:ios-ui-audit": "npm exec --yes --package=eas-cli@27.11.0 --package=agent-device@0.21.41 -- node scripts/verify-ios-ui-audit.mjs",
    "knip": "knip",
    "leanspec": "leanspec",
    "prepare": "vp config --hooks --no-agent",
    "deploy": "vp run --filter @stacks/api deploy"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.1",
    "@leanspec/cli": "0.3.0",
    "@leanspec/mcp": "0.3.0",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0"
}
