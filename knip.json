{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["eas"],
  "ignoreDependencies": ["@leanspec/mcp"],
  "ignore": [".agents/skills/**", "apps/mobile/maestro/scripts/**"],
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/design/main.tsx",
        "preview/boot.ts",
        "preview/vite.config.ts",
        "preview/clerk-stub.tsx",
        "recording-storage/vite.config.ts",
        "offline/worker.js",
        "offline/playwright.config.ts"
      ]
    },
    "apps/mobile": {
      "entry": ["plugins/*.ts"],
      "ignoreDependencies": ["@babel/core", "@react-navigation/elements", "serve"]
    }
  }
}
