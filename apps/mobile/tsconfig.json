{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "uniwind-types.d.ts"],
  "exclude": ["node_modules", "dist", "dist-web"]
}
