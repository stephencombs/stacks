{
  "name": "@stacks/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "eas:dev": "eas build --profile development",
    "eas:preview": "eas build --profile preview",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@expo/metro-runtime": "~58.0.14",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@stacks/client-runtime": "workspace:*",
    "effect": "catalog:",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.15",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "catalog:",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "tailwindcss": "catalog:",
    "uniwind": "1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "catalog:",
    "babel-preset-expo": "~58.0.17",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
