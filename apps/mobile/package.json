{
  "name": "@stacks/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "eas:dev": "eas build --profile development",
    "eas:preview": "eas build --profile preview",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "test:e2e": "expo export --platform web --output-dir dist-web && playwright test",
    "ios:device": "expo run:ios --device"
  },
  "dependencies": {
    "@clerk/expo": "catalog:",
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@stacks/client-runtime": "workspace:*",
    "@stacks/contracts": "workspace:*",
    "@stacks/shared": "workspace:*",
    "effect": "catalog:",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^0.564.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "catalog:",
    "uniwind": "1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@clerk/backend": "catalog:",
    "@clerk/testing": "^2.2.40",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "~58.0.17",
    "serve": "^14.2.4",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
