{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "APP_VARIANT": "development"
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://stacks.stephen-jcombs.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://stacks.stephen-jcombs.workers.dev",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_cmljaC1qYWd1YXItNjczOS5jbGVyay5hY2NvdW50cy5kZXYk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://stacks.stephen-jcombs.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://stacks.stephen-jcombs.workers.dev",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_cmljaC1qYWd1YXItNjczOS5jbGVyay5hY2NvdW50cy5kZXYk"
      },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
