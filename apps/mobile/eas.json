{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": { "APP_VARIANT": "development" },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "env": { "APP_VARIANT": "preview" },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "env": { "APP_VARIANT": "production" },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
