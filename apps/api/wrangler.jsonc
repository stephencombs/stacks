{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stacks-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Locally Hyperdrive is a pass-through to the dev Postgres from docker-compose.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/stacks",
    },
  ],
  "env": {
    // API Worker used by native builds.
    "development": {
      "name": "colorup",
      "workers_dev": true,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "b31cff468a5645638b063167ded46c50" }],
    },
  },
}
