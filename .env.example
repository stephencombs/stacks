# Copy to apps/web/.env.local.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Where the browser reaches the API. Leave unset in dev: Vite proxies /api to the worker.
# VITE_API_URL=

# Mobile: a phone can't reach localhost, so point it at your machine's LAN address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
